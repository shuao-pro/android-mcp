# ============================================================
# Android MCP Server v2.0 — Configuration
# Copy this file to .env and fill in your values
# ============================================================

# -------- Android device connection --------
# ADB-forwarded tunnel address
ANDROID_HOST=127.0.0.1
ANDROID_PORT=18080

# Shared auth token for the Android bridge (shown in the app UI)
ANDROID_TOKEN=

# Request timeout in seconds
REQUEST_TIMEOUT=30.0

# -------- Safety guard --------
# Gate high-risk device operations (shell rm -rf/dd/mount/reboot, file writes
# to /system or /data, app uninstall/clear, system settings, etc.).
#   permissive = allow everything (no confirmation)
#   confirm    = require interactive user approval via the MCP client (default)
#   strict     = block high/medium-risk operations entirely
SAFETY_MODE=confirm

# -------- AI multi-step agent (web chat) --------
# Max tool-call steps per goal (1-50)
AGENT_MAX_STEPS=10
# Capture + describe the screen between steps (visual verification)
AGENT_VISUAL=true
# Transient-error retries per LLM call / tool call
AGENT_MAX_RETRIES=2
# Abort after this many consecutive failed steps
AGENT_MAX_CONSECUTIVE_FAILURES=3

# -------- Web GUI --------
WEB_HOST=127.0.0.1
WEB_PORT=8080

# -------- MCP SSE Server (HTTP transport for web frontends) --------
# Defaults to 127.0.0.1 (loopback) for security.
# Change to 0.0.0.0 to allow phone/WiFi clients to connect.
MCP_HOST=127.0.0.1
MCP_PORT=9000

# Screenshot save directory
SCREENSHOT_DIR=./screenshots

# -------- Vision model (UI element recognition) --------
# Provider: anthropic | openai | custom
#   anthropic - Anthropic Claude Vision (api.anthropic.com)
#   openai    - OpenAI GPT-4o (api.openai.com)
#   custom    - Any OpenAI-compatible endpoint (vLLM, Ollama, local proxy, etc.)
VISION_PROVIDER=anthropic

# API Key (required)
VISION_API_KEY=sk-ant-api03-xxxxx

# Custom API base URL (only needed for VISION_PROVIDER=custom)
# VISION_API_BASE=https://your-custom-endpoint.com/v1

# Model name (leave empty to use provider default)
# Anthropic default: claude-sonnet-5
# OpenAI default:   gpt-4o
# VISION_MODEL=gpt-4o
