# Auto-detect text files, normalize to LF in repo
* text=auto

# Python
*.py text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Config
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.env.example text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Android
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.pro text eol=lf
*.properties text eol=lf

# Binary
*.png binary
*.jpg binary
*.jar binary
*.apk binary
*.aab binary